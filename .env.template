# ==============================================================================
# Variables de entorno del stack (payments-ms).
#
# Copiar a .env en la raiz y completar los valores:
#
#   cp .env.template .env
#
# El .env esta en el .gitignore de la raiz: NO se commitea (tiene las claves de
# Stripe). Compose interpola estas variables con ${...} al leer el compose y se
# las pasa al container de payments-ms.
#
# OJO: NATS_SERVERS tiene dos valores segun donde corra la app.
#   - Host (pnpm start:dev dentro de payments-ms): localhost.
#   - Docker: el compose lo pisa con "nats://nats:4222" (por nombre de
#     servicio), asi que el valor de abajo solo aplica al flujo en host.
# ==============================================================================

PORT=3003

STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

STRIPE_SUCCESS_URL=http://localhost:3003/payments/success
STRIPE_CANCEL_URL=http://localhost:3003/payments/cancel

NATS_SERVERS="nats://localhost:4222,nats://localhost:4223"
